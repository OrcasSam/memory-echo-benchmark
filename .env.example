# Optional LLM backends. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_JUDGE_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=xhigh
DEEPSEEK_API_KEY=
KIMI_API_KEY=

# Cross-model experiment defaults (override only when using another Kimi platform).
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

# Disable optional telemetry during benchmark runs.
POSTHOG_DISABLED=true
MEM0_TELEMETRY=false
